,   1],\n        [INF, INF, INF, 0],\n    ]\n\n    print_matrix(graph, \"Input graph\")\n    distances = floyd_warshall(graph)\n    print_matrix(distances, \"Shortest distances\")\n"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":835,"cache_creation_input_tokens":0,"cache_read_input_tokens":98368,"output_tokens":640,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":0},"inference_geo":"","iterations":[],"speed":"standard"},"diagnostics":null},"requestId":"req_c7e5f2a146485a5c85e5c723"}
